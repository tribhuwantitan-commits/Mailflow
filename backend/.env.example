# MailFlow environment configuration
# Copy this file to .env and replace placeholder values with your own.
# NEVER commit .env with real passwords or secrets to Git.

# Application environment: development, test, or production
APP_ENV=development

# PostgreSQL connection URL (psycopg driver)
# Replace mailflow:change-me with your actual role/password.
# Use 127.0.0.1 for local development; use private networking on production VM.
# Never expose port 5432 publicly.
DATABASE_URL=postgresql+psycopg://mailflow:change-me@127.0.0.1:5432/mailflow

# Database connection timeout in seconds (1-60)
DATABASE_CONNECT_TIMEOUT_SECONDS=5

# SQLAlchemy connection pool size for PostgreSQL (conservative for small VMs)
DATABASE_POOL_SIZE=5

# Maximum overflow connections beyond pool_size
DATABASE_MAX_OVERFLOW=10

# Connection pool timeout in seconds
DATABASE_POOL_TIMEOUT=30

# Connection pool recycle interval in seconds
DATABASE_POOL_RECYCLE=1800

# Auth token expiry in minutes (5-1440, default 30)
AUTH_TOKEN_EXPIRE_MINUTES=30

# Email provider selection: "fake" or "ses"
MAIL_PROVIDER=fake

# Amazon SES configuration (only used when MAIL_PROVIDER=ses)
# Identities are per Region: verify the domain in the SAME region you set here.
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
SES_FROM_EMAIL=noreply@example.com
SES_CONFIGURATION_SET=

# Phase 7c: SES event publishing lands in SNS, which fans out to this SQS queue.
# Leave empty until the queue exists; the poller refuses to start without it.
SQS_EVENT_QUEUE_URL=

# Phase 7c: how long an email body is kept. Metadata and delivery state are kept
# forever; bodies are nulled after this many days (see docs/PHASE-7C-EVENTS.md).
EMAIL_BODY_RETENTION_DAYS=30

# Phase 7c: mailbox advertised in List-Unsubscribe. Leave empty to omit the header.
UNSUBSCRIBE_MAILTO=

# Connection budget. These apply to the API *and* to the workers (outbox, event
# poller, maintenance). On a small managed database, peak connections are
#   API workers x POOL_SIZE + each background worker x POOL_SIZE
# so 4 API workers + 3 workers at 6 = 30. Keep MAX_OVERFLOW at 0 there: waiting
# 30s for a connection beats opening a 7th one against a 1 GB database.
DATABASE_POOL_SIZE=6
DATABASE_MAX_OVERFLOW=0
